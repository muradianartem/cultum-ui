{
  "expo": {
    "name": "cultum-ui",
    "slug": "cultum-ui",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.artemmuradan.cultumui",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Cultum uses your camera to identify plants you photograph."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cultum uses your photos so you can identify a plant from an existing picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4814abf4-2c89-490f-a0f2-c4619d600b82"
      }
    }
  }
}
